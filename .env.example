# PlasticSCM Daily Report 환경변수.
# 이 파일을 복사해서 `.env` 로 이름 변경 후 값 입력.
# `.env` 는 절대 어디에도 업로드되지 않음 (.gitignore + ignore.conf).

# --- 필수 ---
# Anthropic API 키. https://console.anthropic.com/ 에서 발급.
ANTHROPIC_API_KEY=

# PlasticSCM 인증 사용자 이메일. 수집 필터가 아니라 CI profile 생성용.
USER_EMAIL=

# --- 선택 ---
# Claude 모델. 비우면 claude-sonnet-4-6 사용.
CLAUDE_MODEL=

# Discord 웹훅 URL. 채우면 콘솔 출력 + Discord 발송. 비우면 콘솔만.
DISCORD_WEBHOOK=

# PlasticSCM SSO API 토큰. https://www.plasticscm.com/dashboard → Edit Profile → API Keys.
# 로컬은 cm 이 이미 인증돼 있으면 생략 가능. CI 에서는 필수.
PLASTIC_TOKEN=

# PlasticSCM 서버 닉네임 (예: <org>@cloud). CI 에서 PLASTIC_TOKEN 사용 시 필수.
PLASTIC_SERVER=

# 저장소 spec (예: <org>/<repo>@<server>@<owner>). CI 에서 필수.
# 로컬에서는 WORKSPACE_DIR 만 있으면 생략 가능.
PLASTIC_REPO_SPEC=

# 로컬 워크스페이스 절대 경로. PLASTIC_REPO_SPEC 없을 때 필수.
WORKSPACE_DIR=
